<%- include('../partials/debut') %>
<h1>Candidatures reçues</h1>
<p class="sous">Ouvre le dossier avant d'accepter ou de refuser.</p>
<form class="filtres" method="get" action="/entreprise/candidatures">
  <select name="offre" aria-label="Offre">
    <option value="">Toutes les offres</option>
    <% offres.forEach(function (o) { %>
      <option value="<%= o.id %>" <%= String(filtre) === String(o.id) ? 'selected' : '' %>><%= o.titre %></option>
    <% }) %>
  </select>
  <button class="btn" type="submit">Filtrer</button>
</form>
<% if (!candidatures.length) { %>
  <p class="aide">Aucune candidature pour le moment.</p>
<% } else { %>
<div class="tableau"><table>
  <tr><th>Étudiant</th><th>Filière</th><th>Offre</th><th>Date</th><th>État</th><th></th></tr>
  <% candidatures.forEach(function (c) { %>
    <tr data-candidature="<%= c.id %>">
      <td><%= c.prenom %> <%= c.nom %></td>
      <td><%= c.filiere || '—' %></td>
      <td><%= c.titre %></td>
      <td><%= dateFr(c.cree_le) %></td>
      <td><%- badge('candidature', c.statut) %></td>
      <td><a href="/entreprise/candidatures/<%= c.id %>">Consulter le dossier</a></td>
    </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('../partials/fin') %>

<%- include('partials/debut') %>
<h1>Notifications</h1>
<p class="sous">Tes dernières alertes.</p>
<div class="carte">
  <% if (!notifications.length) { %>
    <p class="aide">Aucune notification.</p>
  <% } else { %>
    <ul class="fil">
      <% notifications.forEach(function (n) { %>
        <li>
          <% if (n.lien) { %><a href="<%= n.lien %>"><b><%= n.titre %></b></a><% } else { %><b><%= n.titre %></b><% } %>
          <small><%= n.message %> · <%= dateHeureFr(n.cree_le) %></small>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<%- include('partials/fin') %>

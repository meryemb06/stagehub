<%- include('../partials/debut') %>
<div class="entete">
  <div>
    <h1>Statistiques</h1>
    <p class="sous">Chiffres calculés à partir des données de la plateforme.</p>
  </div>
  <div class="actions">
    <a class="btn btn-contour" href="/admin/statistiques/pdf">Exporter en PDF</a>
    <a class="btn btn-contour" href="/admin/statistiques/excel">Exporter en Excel</a>
  </div>
</div>
<div class="stats">
  <div class="stat"><b><%= stats.etudiants %></b><span>Étudiants inscrits</span></div>
  <div class="stat"><b><%= stats.entreprises %></b><span>Entreprises</span></div>
  <div class="stat"><b><%= stats.encadrants %></b><span>Encadrants</span></div>
  <div class="stat"><b><%= stats.offres %></b><span>Offres publiées</span></div>
  <div class="stat"><b><%= stats.stagesEnCours %></b><span>Stages en cours</span></div>
  <div class="stat"><b><%= stats.stagesTermines %></b><span>Stages terminés</span></div>
</div>
<div class="carte">
  <h2>Candidatures par état</h2>
  <p>Acceptées (<%= stats.acceptees.n %>)</p>
  <div class="progress"><i style="width:<%= stats.acceptees.pct %>%"></i></div>
  <p>En attente (<%= stats.enAttente.n %>)</p>
  <div class="progress"><i style="width:<%= stats.enAttente.pct %>%"></i></div>
  <p>Refusées (<%= stats.refusees.n %>)</p>
  <div class="progress"><i style="width:<%= stats.refusees.pct %>%"></i></div>
</div>
<div class="ligne2">
  <div class="carte">
    <h2>Notes moyennes</h2>
    <p>Entreprise : <b><%= stats.moyenneEntreprise == null ? '—' : stats.moyenneEntreprise + '/20' %></b></p>
    <p>Encadrant : <b><%= stats.moyenneEncadrant == null ? '—' : stats.moyenneEncadrant + '/20' %></b></p>
  </div>
  <div class="carte">
    <h2>Offres par ville</h2>
    <% if (!stats.villes.length) { %><p class="aide">Aucune offre publiée.</p><% } %>
    <ul class="fil">
      <% stats.villes.forEach(function (v) { %>
        <li><b><%= v.ville %></b><small><%= v.n %> offre<%= v.n > 1 ? 's' : '' %></small></li>
      <% }) %>
    </ul>
  </div>
</div>
<%- include('../partials/fin') %>

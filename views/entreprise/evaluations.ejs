<%- include('../partials/debut') %>
<h1>Évaluer un stagiaire</h1>
<p class="sous">Grille d'évaluation et commentaire de fin de stage.</p>
<% if (!stages.length) { %>
  <p class="aide">Aucun stagiaire pour le moment. Accepte d'abord une candidature.</p>
<% } else { %>
<div class="tableau"><table>
  <tr><th>Étudiant</th><th>Filière</th><th>Offre</th><th>Stage</th><th>Note</th><th></th></tr>
  <% stages.forEach(function (s) { %>
    <tr>
      <td><%= s.prenom %> <%= s.nom %></td>
      <td><%= s.filiere || '—' %></td>
      <td><%= s.titre %></td>
      <td><%- badge('stage', s.statut) %></td>
      <td><%= s.note_entreprise == null ? '—' : s.note_entreprise + '/20' %></td>
      <td><a href="/entreprise/stages/<%= s.id %>/evaluation"><%= s.note_entreprise == null ? 'Évaluer' : 'Modifier' %></a></td>
    </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('../partials/fin') %>

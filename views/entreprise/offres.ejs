<%- include('../partials/debut') %>
<div class="entete">
  <div>
    <h1>Mes offres</h1>
    <p class="sous">Offres publiées par <%= user.raison_sociale || 'ton entreprise' %>.</p>
  </div>
  <a class="btn btn-bleu" href="/entreprise/offres/nouvelle">+ Publier une offre</a>
</div>
<% if (!offres.length) { %>
  <p class="aide">Tu n'as pas encore publié d'offre.</p>
<% } else { %>
<div class="tableau"><table>
  <tr><th>Titre</th><th>Ville</th><th>Durée</th><th>Candidatures</th><th>Actions</th></tr>
  <% offres.forEach(function (o) { %>
    <tr data-offre="<%= o.id %>" data-titre="<%= o.titre %>">
      <td><%= o.titre %> <% if (o.retiree) { %><span class="etat e-ko">Retirée</span><% } %></td>
      <td><%= o.ville %></td>
      <td><%= o.duree_mois %> mois</td>
      <td><a href="/entreprise/candidatures?offre=<%= o.id %>"><%= o.nb %></a></td>
      <td>
        <% if (!o.retiree) { %>
          <a href="/entreprise/offres/<%= o.id %>/modifier">Modifier</a>
          ·
          <form method="post" action="/entreprise/offres/<%= o.id %>/supprimer" onsubmit="return confirm('Supprimer ou retirer cette offre ?');">
            <%- include('../partials/csrf') %>
            <button class="btn btn-ko btn-petit" type="submit">Supprimer</button>
          </form>
        <% } else { %>
          <span class="aide">Conservée pour les stages acceptés</span>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('../partials/fin') %>

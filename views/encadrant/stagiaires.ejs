<%- include('../partials/debut') %>
<h1>Mes stagiaires</h1>
<p class="sous">Les étudiants qui te sont affectés.</p>
<% if (!enCours.length && !termines.length) { %>
  <div class="carte"><p class="aide">Aucun stagiaire ne t'est affecté pour le moment.</p></div>
<% } %>
<% if (enCours.length) { %>
  <h2>Stages en cours</h2>
  <div class="tableau"><table>
    <tr><th>Étudiant</th><th>Entreprise</th><th>Offre</th><th>Avancement</th><th>Note</th><th></th></tr>
    <% enCours.forEach(function (s) { %>
      <tr>
        <td><%= s.prenom %> <%= s.nom %><br><span class="aide"><%= s.filiere %></span></td>
        <td><%= s.raison_sociale %></td>
        <td><%= s.titre %></td>
        <td style="min-width:150px"><div class="progress"><i style="width:<%= s.etat.pourcent %>%"></i></div><%= s.etat.pourcent %>%</td>
        <td><%= s.note_encadrant == null ? '—' : s.note_encadrant + '/20' %></td>
        <td><a href="/encadrant/stagiaires/<%= s.id %>">Voir le suivi</a></td>
      </tr>
    <% }) %>
  </table></div>
<% } %>
<% if (termines.length) { %>
  <h2>Stages terminés</h2>
  <div class="tableau"><table>
    <tr><th>Étudiant</th><th>Entreprise</th><th>Offre</th><th>Note</th><th></th></tr>
    <% termines.forEach(function (s) { %>
      <tr>
        <td><%= s.prenom %> <%= s.nom %></td>
        <td><%= s.raison_sociale %></td>
        <td><%= s.titre %></td>
        <td><%= s.note_encadrant == null ? '—' : s.note_encadrant + '/20' %></td>
        <td><a href="/encadrant/stagiaires/<%= s.id %>">Consulter</a></td>
      </tr>
    <% }) %>
  </table></div>
<% } %>
<%- include('../partials/fin') %>

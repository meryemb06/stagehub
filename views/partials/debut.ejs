<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titre %> · StageHub</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/pages.css">
</head>
<body class="role-<%= user.role %>">
<% const accueilRole = { etudiant: '/offres', entreprise: '/entreprise/offres', encadrant: '/encadrant/stagiaires', admin: '/admin/comptes' }[user.role] || '/'; %>
<header class="barre">
  <a class="logo" href="<%= accueilRole %>"><svg class="sceau" viewBox="0 0 40 40" aria-hidden="true"><path d="M6 26c7-14 21-14 28 0" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/><circle cx="30" cy="11" r="3" fill="#ff5a36"/></svg>StageHub</a>
  <button class="burger" type="button" aria-expanded="false" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
  <%- include('menu') %>
</header>
<div class="voile" hidden></div>
<main class="contenu">
<% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>

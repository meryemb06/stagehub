<%- include('../partials/auth-debut', { large: true }) %>
<p class="sous">Plateforme de gestion des stages et PFE</p>
<form action="/connexion" method="post">
  <%- include('../partials/csrf') %>
  <label for="index-email">Adresse e-mail</label>
  <input type="email" id="index-email" name="email" autocomplete="username" required>
  <label for="index-mdp">Mot de passe</label>
  <input type="password" id="index-mdp" name="mot_de_passe" autocomplete="current-password" required>
  <button class="btn btn-bleu btn-plein" type="submit">Se connecter</button>
</form>
<p class="lien-bas"><a href="/mot-de-passe-oublie">Mot de passe oublié ?</a></p>
<p class="lien-bas">Pas de compte ? <a href="/inscription">S'inscrire</a></p>
<% if (demos.length) { %>
<div class="demo">
  <h2>Comptes de démonstration</h2>
  <p class="aide">Mot de passe commun : <%= demoPassword %></p>
  <% demos.forEach(function (demo) { %>
    <form method="post" action="/connexion">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="email" value="<%= demo.email %>">
      <input type="hidden" name="mot_de_passe" value="<%= demoPassword %>">
      <span><strong><%= demo.nom %></strong><br><%= demo.role %> · <%= demo.email %></span>
      <button class="btn btn-contour btn-petit" type="submit">Entrer</button>
    </form>
  <% }) %>
</div>
<% } %>
<%- include('../partials/auth-fin') %>

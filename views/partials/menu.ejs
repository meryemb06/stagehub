<%
function icone(nom) {
  const traits = {
    offres: '<path d="M4 7h16M4 12h16M4 17h10"/>',
    dossier: '<path d="M4 6h6l2 2h8v10H4z"/>',
    doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/>',
    suivi: '<path d="M5 19V9M12 19V5M19 19v-7"/>',
    hist: '<path d="M4 12a8 8 0 1 0 2-5"/><path d="M4 4v4h4"/>',
    cloche: '<path d="M6 16V10a6 6 0 1 1 12 0v6l1 2H5z"/><path d="M10 19a2 2 0 0 0 4 0"/>',
    user: '<circle cx="12" cy="8" r="3"/><path d="M5 19c1.5-3 4-4 7-4s5.5 1 7 4"/>',
    plus: '<path d="M12 5v14M5 12h14"/>',
    etoile: '<path d="M12 3l2.2 6.2H21l-5.2 3.8L17.8 20 12 16.2 6.2 20l2-6.9L3 9.2h6.8z"/>',
    lien: '<path d="M8 12h8"/><path d="M9 7H7a5 5 0 0 0 0 10h2M15 7h2a5 5 0 0 1 0 10h-2"/>',
    stats: '<path d="M4 19h16"/><path d="M7 16V9M12 16V5M17 16v-4"/>'
  };
  return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (traits[nom] || traits.offres) + '</svg>';
}
%>
<nav class="menu">
  <div class="liens">
  <% if (user.role === 'etudiant') { %>
    <a href="/offres" class="<%= active === 'offres' ? 'actif' : '' %>"><%- icone('offres') %>Découvrir</a>
    <a href="/candidatures" class="<%= active === 'candidatures' ? 'actif' : '' %>"><%- icone('dossier') %>Candidatures</a>
    <a href="/documents" class="<%= active === 'documents' ? 'actif' : '' %>"><%- icone('doc') %>Documents</a>
    <a href="/suivi" class="<%= active === 'suivi' ? 'actif' : '' %>"><%- icone('suivi') %>Suivi</a>
    <a href="/historique" class="<%= active === 'historique' ? 'actif' : '' %>"><%- icone('hist') %>Passés</a>
  <% } else if (user.role === 'entreprise') { %>
    <a href="/entreprise/offres" class="<%= active === 'offres' ? 'actif' : '' %>"><%- icone('offres') %>Offres</a>
    <a href="/entreprise/offres/nouvelle" class="<%= active === 'publier' ? 'actif' : '' %>"><%- icone('plus') %>Publier</a>
    <a href="/entreprise/candidatures" class="<%= active === 'candidatures' ? 'actif' : '' %>"><%- icone('dossier') %>Dossiers</a>
    <a href="/entreprise/evaluations" class="<%= active === 'evaluations' ? 'actif' : '' %>"><%- icone('etoile') %>Évaluer</a>
  <% } else if (user.role === 'encadrant') { %>
    <a href="/encadrant/stagiaires" class="<%= active === 'stagiaires' ? 'actif' : '' %>"><%- icone('user') %>Stagiaires</a>
    <a href="/encadrant/documents" class="<%= active === 'documents' ? 'actif' : '' %>"><%- icone('doc') %>Documents</a>
  <% } else if (user.role === 'admin') { %>
    <a href="/admin/comptes" class="<%= active === 'comptes' ? 'actif' : '' %>"><%- icone('user') %>Comptes</a>
    <a href="/admin/affectations" class="<%= active === 'affectations' ? 'actif' : '' %>"><%- icone('lien') %>Affectations</a>
    <a href="/admin/statistiques" class="<%= active === 'stats' ? 'actif' : '' %>"><%- icone('stats') %>Statistiques</a>
  <% } %>
  <% if (user.role !== 'admin') { %>
    <a href="/notifications" class="<%= active === 'notifications' ? 'actif' : '' %>"><%- icone('cloche') %>Alertes<% if (notifCount) { %> (<%= notifCount %>)<% } %></a>
    <a href="/profil" class="<%= active === 'profil' ? 'actif' : '' %>"><%- icone('user') %>Profil</a>
  <% } %>
  </div>
  <div class="bas">
    <div class="qui" title="<%= user.email %>">
      <span class="avatar"><%= (user.prenom || user.nom || 'S').slice(0, 1).toUpperCase() %></span>
      <div>
        <strong><%= nomAffiche(user) %></strong>
        <small><%= roleLabel(user.role) %></small>
      </div>
    </div>
    <form class="deco" method="post" action="/deconnexion">
      <%- include('csrf') %>
      <button type="submit">Sortir</button>
    </form>
  </div>
</nav>

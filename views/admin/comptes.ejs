<%- include('../partials/debut') %>
<h1>Gestion des comptes</h1>
<p class="sous">Réinitialise un mot de passe, désactive un compte, ou crée un encadrant.</p>
<% if (demandes.length) { %>
  <div class="carte">
    <h2>Demandes de mot de passe</h2>
    <ul class="fil">
      <% demandes.forEach(function (d) { %>
        <li>
          <b><%= nomAffiche(d) %></b>
          <small><%= d.email %> · <%= roleLabel(d.role) %> · <%= dateHeureFr(d.demande_le) %></small>
          <form method="post" action="/admin/comptes/reinitialiser">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="utilisateur_id" value="<%= d.utilisateur_id %>">
            <button class="btn btn-petit" type="submit">Générer un mot de passe</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>
<form class="filtres" method="get" action="/admin/comptes">
  <input type="search" name="q" value="<%= q %>" placeholder="Nom, e-mail, filière...">
  <button class="btn" type="submit">Rechercher</button>
</form>
<div class="tableau"><table>
  <tr><th>Nom</th><th>E-mail</th><th>Rôle</th><th>Compte</th><th>Actions</th></tr>
  <% comptes.forEach(function (c) { %>
    <tr>
      <td><%= nomAffiche(c) %><% if (c.filiere) { %><br><span class="aide"><%= c.filiere %></span><% } %></td>
      <td><%= c.email %></td>
      <td><%= roleLabel(c.role) %></td>
      <td><%- badge('compte', c.actif) %></td>
      <td>
        <form method="post" action="/admin/comptes/reinitialiser">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="utilisateur_id" value="<%= c.id %>">
          <button class="btn btn-contour btn-petit" type="submit">Réinitialiser</button>
        </form>
        <% if (c.id !== user.id) { %>
          <form method="post" action="/admin/comptes/basculer">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="utilisateur_id" value="<%= c.id %>">
            <button class="btn <%= c.actif ? 'btn-ko' : 'btn-ok' %> btn-petit" type="submit"><%= c.actif ? 'Désactiver' : 'Réactiver' %></button>
          </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table></div>
<form class="carte" method="post" action="/admin/encadrants">
  <%- include('../partials/csrf') %>
  <h2>Créer un encadrant</h2>
  <div class="ligne2">
    <div><label for="nom">Nom</label><input id="nom" name="nom" required maxlength="80"></div>
    <div><label for="prenom">Prénom</label><input id="prenom" name="prenom" required maxlength="80"></div>
  </div>
  <label for="email">Adresse e-mail</label>
  <input type="email" id="email" name="email" required>
  <label for="mot_de_passe">Mot de passe (laisser vide pour en générer un)</label>
  <input type="text" id="mot_de_passe" name="mot_de_passe" minlength="8" autocomplete="off">
  <div class="actions"><button class="btn btn-bleu" type="submit">Créer le compte</button></div>
</form>
<%- include('../partials/fin') %>

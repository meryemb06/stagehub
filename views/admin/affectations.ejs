<%- include('../partials/debut') %>
<h1>Affecter un encadrant</h1>
<p class="sous">Associe chaque stagiaire en cours à un encadrant. Sans cette affectation, l'encadrant ne voit pas le stagiaire.</p>
<% if (!encadrants.length) { %>
  <div class="carte"><p>Aucun encadrant actif. <a href="/admin/comptes">Crée un compte encadrant</a> d'abord.</p></div>
<% } else if (!stages.length) { %>
  <p class="aide">Aucun stage en cours.</p>
<% } else { %>
<div class="tableau"><table>
  <tr><th>Stagiaire</th><th>Offre</th><th>Entreprise</th><th>Encadrant actuel</th><th>Affectation</th></tr>
  <% stages.forEach(function (s) { %>
    <tr data-stage="<%= s.id %>" data-email="<%= s.email %>">
      <td><%= s.prenom %> <%= s.nom %><br><span class="aide"><%= s.email %></span></td>
      <td><%= s.titre %></td>
      <td><%= s.raison_sociale %></td>
      <td><%= s.enc_nom ? 'Pr. ' + s.enc_nom : '— Non affecté' %></td>
      <td>
        <form method="post" action="/admin/affectations">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="stage_id" value="<%= s.id %>">
          <select name="encadrant_id" aria-label="Encadrant pour <%= s.prenom %> <%= s.nom %>" required>
            <option value="">Choisir</option>
            <% encadrants.forEach(function (e) { %>
              <option value="<%= e.id %>" data-email="<%= e.email %>" <%= s.encadrant_id === e.id ? 'selected' : '' %>>Pr. <%= e.nom %></option>
            <% }) %>
          </select>
          <div class="actions"><button class="btn btn-bleu btn-petit" type="submit">Affecter</button></div>
        </form>
      </td>
    </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('../partials/fin') %>

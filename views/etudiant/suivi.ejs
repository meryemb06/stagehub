<%- include('../partials/debut') %>
<h1>Suivi de mon stage</h1>
<% if (!stages.length) { %>
  <p class="sous">Tu n'as pas de stage en cours.</p>
  <div class="carte">
    <p>Quand une entreprise accepte ta candidature, le journal de bord et les commentaires de l'encadrant s'affichent ici.</p>
    <% if (nbTermines) { %><p><a href="/historique">Voir mes stages précédents</a></p><% } %>
  </div>
<% } else { %>
  <% if (stages.length > 1) { %>
    <form method="get" action="/suivi" class="filtres">
      <select name="stage" aria-label="Stage">
        <% stages.forEach(function (s) { %>
          <option value="<%= s.id %>" <%= stage && stage.id === s.id ? 'selected' : '' %>><%= s.titre %> — <%= s.raison_sociale %></option>
        <% }) %>
      </select>
      <button class="btn" type="submit">Afficher</button>
    </form>
  <% } %>
  <p class="sous"><%= stage.raison_sociale %> · <%= stage.titre %><% if (stage.enc_nom) { %> · Encadrant : Pr. <%= stage.enc_nom %><% } else { %> · Encadrant pas encore affecté<% } %></p>
  <div class="stats">
    <div class="stat"><b><%= stage.etat.pourcent %>%</b><span>Avancement du dossier</span></div>
    <div class="stat"><b><%= stage.nbJournal %></b><span>Entrées de journal</span></div>
    <div class="stat"><b><%= stage.etat.rap ? 1 : 0 %></b><span>Rapport déposé</span></div>
  </div>
  <div class="carte">
    <h2>Où en est le dossier</h2>
    <ul class="checklist">
      <% stage.etat.items.forEach(function (item) { %>
        <li><span><%= item.label %></span><span class="etat <%= item.ok ? 'e-ok' : 'e-att' %>"><%= item.ok ? 'Fait' : 'À faire' %></span></li>
      <% }) %>
    </ul>
  </div>
  <div class="carte">
    <h2>Journal de bord</h2>
    <% if (!journal.length) { %><p class="aide">Aucune entrée pour le moment.</p><% } %>
    <ul class="fil">
      <% journal.forEach(function (entree) { %>
        <li>
          <b><%= dateFr(entree.date_entree) %></b>
          <small>Tâches : <%= entree.taches %></small>
          <% if (entree.difficultes) { %><small>Difficultés : <%= entree.difficultes %></small><% } %>
          <% if (entree.feedback) { %><div class="bulle"><small>Encadrant<% if (entree.feedback_le) { %> · <%= dateFr(entree.feedback_le) %><% } %></small><%- nl2br(entree.feedback) %></div><% } %>
        </li>
      <% }) %>
    </ul>
    <form action="/suivi/journal" method="post">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="stage_id" value="<%= stage.id %>">
      <label for="date_entree">Date</label>
      <input type="date" id="date_entree" name="date_entree" value="<%= aujourdhui %>" max="<%= aujourdhui %>" required>
      <label for="taches">Tâches réalisées</label>
      <textarea id="taches" name="taches" required></textarea>
      <label for="difficultes">Difficultés rencontrées</label>
      <textarea id="difficultes" name="difficultes"></textarea>
      <div class="actions"><button class="btn btn-bleu" type="submit">Ajouter l'entrée</button></div>
    </form>
  </div>
  <div class="carte">
    <h2>Commentaires de l'encadrant</h2>
    <% if (!commentaires.length) { %><p class="aide">Pas encore de commentaire.</p><% } %>
    <% commentaires.forEach(function (c) { %>
      <div class="bulle <%= c.auteur_id === user.id ? 'moi' : '' %>">
        <small><%= c.auteur_id === user.id ? 'Moi' : nomAffiche(c) %> · <%= dateHeureFr(c.cree_le) %></small>
        <%- nl2br(c.contenu) %>
      </div>
    <% }) %>
    <% if (stage.encadrant_id) { %>
      <form action="/suivi/commentaire" method="post">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="stage_id" value="<%= stage.id %>">
        <label for="reponse">Répondre</label>
        <textarea id="reponse" name="contenu" required></textarea>
        <div class="actions"><button class="btn btn-contour btn-petit" type="submit">Envoyer la réponse</button></div>
      </form>
    <% } else { %>
      <p class="aide">Les échanges commenceront quand l'administrateur t'aura affecté un encadrant.</p>
    <% } %>
  </div>
  <% if (stage.note_entreprise != null || stage.note_encadrant != null) { %>
    <div class="carte">
      <h2>Notes déjà saisies</h2>
      <% if (stage.note_entreprise != null) { %><p>Entreprise : <b><%= stage.note_entreprise %>/20</b></p><% if (stage.commentaire_entreprise) { %><p><%- nl2br(stage.commentaire_entreprise) %></p><% } %><% } %>
      <% if (stage.note_encadrant != null) { %><p>Encadrant : <b><%= stage.note_encadrant %>/20</b></p><% if (stage.appreciation_encadrant) { %><p><%- nl2br(stage.appreciation_encadrant) %></p><% } %><% } %>
    </div>
  <% } %>
  <p><a href="/documents?stage=<%= stage.id %>">Déposer la convention ou le rapport &rarr;</a></p>
  <% if (nbTermines) { %><p><a href="/historique">Voir mes stages précédents &rarr;</a></p><% } %>
<% } %>
<%- include('../partials/fin') %>

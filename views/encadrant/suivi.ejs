<%- include('../partials/debut') %>
<p><a href="/encadrant/stagiaires">&larr; Retour à mes stagiaires</a></p>
<h1>Journal de bord : <%= stage.prenom %> <%= stage.nom %></h1>
<p class="sous"><%= stage.raison_sociale %> · <%= stage.titre %> · <%= stage.filiere || 'Filière non renseignée' %></p>
<div class="stats">
  <div class="stat"><b><%= stage.etat.pourcent %>%</b><span>Avancement du dossier</span></div>
  <div class="stat"><b><%= stage.nbJournal %></b><span>Entrées de journal</span></div>
  <div class="stat"><b><%= stage.note_encadrant == null ? '—' : stage.note_encadrant %></b><span>Ta note /20</span></div>
</div>
<div class="carte">
  <h2>Entrées du journal</h2>
  <% if (!journal.length) { %><p class="aide">L'étudiant n'a pas encore écrit dans son journal.</p><% } %>
  <% journal.forEach(function (entree) { %>
    <div class="carte" style="margin-top:10px">
      <b><%= dateFr(entree.date_entree) %></b>
      <p><b>Tâches :</b> <%- nl2br(entree.taches) %></p>
      <% if (entree.difficultes) { %><p><b>Difficultés :</b> <%- nl2br(entree.difficultes) %></p><% } %>
      <% if (entree.feedback) { %><div class="bulle"><small>Ton feedback<% if (entree.feedback_le) { %> · <%= dateFr(entree.feedback_le) %><% } %></small><%- nl2br(entree.feedback) %></div><% } %>
      <form class="petit-form" method="post" action="/encadrant/journal/<%= entree.id %>/feedback">
        <%- include('../partials/csrf') %>
        <label for="feedback-<%= entree.id %>">Feedback sur cette entrée</label>
        <textarea id="feedback-<%= entree.id %>" name="feedback" required><%= entree.feedback || '' %></textarea>
        <div class="actions"><button class="btn btn-contour btn-petit" type="submit">Enregistrer le feedback</button></div>
      </form>
    </div>
  <% }) %>
</div>
<div class="carte">
  <h2>Commenter le suivi</h2>
  <p class="aide">Ces commentaires sont visibles par l'étudiant, qui peut y répondre.</p>
  <% commentaires.forEach(function (c) { %>
    <div class="bulle <%= c.auteur_id === user.id ? 'moi' : '' %>">
      <small><%= c.auteur_id === user.id ? 'Moi' : nomAffiche(c) %> · <%= dateHeureFr(c.cree_le) %></small>
      <%- nl2br(c.contenu) %>
    </div>
  <% }) %>
  <form method="post" action="/encadrant/stages/<%= stage.id %>/commentaire">
    <%- include('../partials/csrf') %>
    <label for="contenu">Commentaire</label>
    <textarea id="contenu" name="contenu" required></textarea>
    <div class="actions"><button class="btn btn-bleu" type="submit">Envoyer</button></div>
  </form>
</div>
<form class="carte" method="post" action="/encadrant/stages/<%= stage.id %>/note">
  <%- include('../partials/csrf') %>
  <h2>Noter le stagiaire</h2>
  <div class="ligne2">
    <div>
      <label for="note">Note (/20)</label>
      <input type="number" id="note" name="note" min="0" max="20" step="0.5" required value="<%= stage.note_encadrant == null ? '' : stage.note_encadrant %>">
    </div>
    <div>
      <label for="appreciation">Appréciation</label>
      <input id="appreciation" name="appreciation" required maxlength="2000" value="<%= stage.appreciation_encadrant || '' %>">
    </div>
  </div>
  <div class="actions"><button class="btn" type="submit">Enregistrer la note</button></div>
</form>
<% if (stage.note_entreprise != null) { %>
  <div class="carte">
    <h2>Évaluation de l'entreprise</h2>
    <p>Note : <b><%= stage.note_entreprise %>/20</b></p>
    <% if (stage.commentaire_entreprise) { %><p><%- nl2br(stage.commentaire_entreprise) %></p><% } %>
    <p class="aide">Assiduité <%= stage.assiduite %>, compétences <%= stage.competences_tech %>, autonomie <%= stage.autonomie %>, communication <%= stage.communication %>, qualité <%= stage.qualite %>.</p>
  </div>
<% } %>
<% if (stage.statut === 'en_cours') { %>
  <form method="post" action="/encadrant/stages/<%= stage.id %>/cloturer" onsubmit="return confirm('Clôturer ce stage ? Il passera dans l\'historique de l\'étudiant.');">
    <%- include('../partials/csrf') %>
    <button class="btn btn-bleu" type="submit">Clôturer le stage</button>
  </form>
<% } else { %>
  <p><span class="etat e-ok">Stage terminé</span></p>
<% } %>
<p style="margin-top:14px"><a href="/encadrant/documents">Valider les documents &rarr;</a></p>
<%- include('../partials/fin') %>

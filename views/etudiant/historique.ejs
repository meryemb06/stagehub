<%- include('../partials/debut') %>
<h1>Stages précédents</h1>
<p class="sous">L'historique de tes stages terminés, avec les notes et les appréciations.</p>
<% if (!stages.length) { %>
  <div class="carte"><p class="aide">Aucun stage précédent.</p></div>
<% } %>
<% stages.forEach(function (s) { %>
  <article class="carte">
    <h2><%= s.titre %></h2>
    <p class="sous"><%= s.raison_sociale %><% if (s.enc_nom) { %> · Pr. <%= s.enc_nom %><% } %><% if (s.date_debut) { %> · <%= dateFr(s.date_debut) %> – <%= dateFr(s.date_fin) %><% } %></p>
    <% if (s.sujet) { %><p><b>Sujet :</b> <%= s.sujet %></p><% } %>
    <div class="ligne2">
      <div>
        <p>Note de l'entreprise</p>
        <p><b><%= s.note_entreprise == null ? '—' : s.note_entreprise + '/20' %></b></p>
        <% if (s.commentaire_entreprise) { %><p><%- nl2br(s.commentaire_entreprise) %></p><% } %>
      </div>
      <div>
        <p>Note de l'encadrant</p>
        <p><b><%= s.note_encadrant == null ? '—' : s.note_encadrant + '/20' %></b></p>
        <% if (s.appreciation_encadrant) { %><p><%- nl2br(s.appreciation_encadrant) %></p><% } %>
      </div>
    </div>
    <% if (s.assiduite) { %>
      <p class="aide">Grille entreprise : assiduité <%= s.assiduite %>, compétences <%= s.competences_tech %>, autonomie <%= s.autonomie %>, communication <%= s.communication %>, qualité <%= s.qualite %>.</p>
    <% } %>
    <div class="actions">
      <% s.documents.forEach(function (d) { if (d.fichier_stocke) { %>
        <a class="btn btn-contour btn-petit" href="/fichiers/document/<%= d.id %>"><%= d.type === 'rapport' ? 'Rapport' : 'Convention' %></a>
      <% } }) %>
    </div>
  </article>
<% }) %>
<%- include('../partials/fin') %>

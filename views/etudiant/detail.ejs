<%- include('../partials/debut') %>
<p><a href="/offres">← Revenir à la pile</a></p>
<article class="affiche">
  <div>
    <p class="kicker"><%= offre.raison_sociale %></p>
    <h1><%= offre.titre %></h1>
    <div class="pastilles">
      <span class="pastille"><%= offre.ville %></span>
      <span class="pastille"><%= offre.duree_mois %> mois</span>
    </div>
  </div>
  <% if (offre.deja) { %>
    <%- badge('candidature', offre.deja) %>
  <% } else { %>
    <a class="btn btn-bleu" href="/offres/<%= offre.id %>/postuler">Postuler</a>
  <% } %>
</article>
<div class="ligne2">
  <div class="carte"><h2>Description</h2><p><%- nl2br(offre.description) %></p></div>
  <div>
    <% if (lignes(offre.missions).length) { %>
    <div class="carte"><h2>Missions</h2><ul><% lignes(offre.missions).forEach(function (m) { %><li><%= m %></li><% }) %></ul></div>
    <% } %>
    <% if (offre.competences) { %>
    <div class="carte"><h2>Compétences</h2><p><%= offre.competences %></p></div>
    <% } %>
    <div class="carte"><h2>Présentation</h2>
      <% if (offre.document_stocke) { %>
        <a href="/fichiers/offre/<%= offre.id %>">Télécharger <%= offre.document_nom || 'le PDF' %></a>
      <% } else { %>
        <p class="aide">Aucun document joint.</p>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/fin') %>

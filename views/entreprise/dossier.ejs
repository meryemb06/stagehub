<%- include('../partials/debut') %>
<p><a href="/entreprise/candidatures">&larr; Retour aux candidatures</a></p>
<h1><%= dossier.prenom %> <%= dossier.nom %></h1>
<p class="sous"><%= dossier.titre %> · <%= dossier.ville %> · <%= dossier.duree_mois %> mois</p>
<div class="carte">
  <h2>Dossier</h2>
  <p><b>Filière :</b> <%= dossier.filiere || '—' %></p>
  <p><b>Compétences :</b> <%= dossier.competences || '—' %></p>
  <p><b>E-mail :</b> <%= dossier.email %></p>
  <p><a href="/fichiers/candidature/<%= dossier.id %>/cv">Télécharger le CV<% if (dossier.cv_nom) { %> (<%= dossier.cv_nom %>)<% } %></a></p>
  <% if (dossier.convention_stocke) { %>
    <p><a href="/fichiers/candidature/<%= dossier.id %>/convention">Télécharger la convention<% if (dossier.convention_nom) { %> (<%= dossier.convention_nom %>)<% } %></a></p>
  <% } %>
  <h2>Lettre de motivation</h2>
  <p><%- nl2br(dossier.lettre) %></p>
  <p>État : <%- badge('candidature', dossier.statut) %></p>
  <% if (dossier.statut === 'en_attente') { %>
    <div class="actions">
      <form method="post" action="/entreprise/candidatures/<%= dossier.id %>/decision">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="decision" value="acceptee">
        <button class="btn btn-ok" type="submit">Accepter</button>
      </form>
      <form method="post" action="/entreprise/candidatures/<%= dossier.id %>/decision">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="decision" value="refusee">
        <button class="btn btn-ko" type="submit">Refuser</button>
      </form>
    </div>
  <% } %>
</div>
<%- include('../partials/fin') %>

<%- include('../partials/auth-debut') %>
<p class="kicker">Inscription</p>
<h1>Créer un compte</h1>
<p class="sous">Étudiant ou entreprise. Les encadrants sont ouverts par l'administration.</p>
<form action="/inscription" method="post">
  <%- include('../partials/csrf') %>
  <label for="inscription-role">Je suis</label>
  <select id="inscription-role" name="role">
    <option value="etudiant">Étudiant</option>
    <option value="entreprise">Entreprise</option>
  </select>
  <div class="ligne2">
    <div><label for="inscription-nom">Nom</label><input id="inscription-nom" name="nom" required maxlength="80"></div>
    <div><label for="inscription-prenom">Prénom</label><input id="inscription-prenom" name="prenom" required maxlength="80"></div>
  </div>
  <label for="inscription-filiere">Filière (étudiants)</label>
  <input id="inscription-filiere" name="filiere" maxlength="120">
  <label for="inscription-raison">Raison sociale (entreprises)</label>
  <input id="inscription-raison" name="raison_sociale" maxlength="140">
  <label for="inscription-email">Adresse e-mail</label>
  <input type="email" id="inscription-email" name="email" autocomplete="username" required>
  <label for="inscription-mdp">Mot de passe</label>
  <input type="password" id="inscription-mdp" name="mot_de_passe" minlength="8" autocomplete="new-password" required>
  <p class="aide">8 caractères minimum. Les encadrants sont créés par l'administrateur.</p>
  <button class="btn btn-bleu btn-plein" type="submit">Créer mon compte</button>
</form>
<p class="lien-bas">Déjà inscrit ? <a href="/">Se connecter</a></p>
<%- include('../partials/auth-fin') %>

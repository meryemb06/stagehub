<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titre %> · StageHub</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/pages.css">
</head>
<body class="porte<%= typeof accueil !== 'undefined' && accueil ? ' porte-accueil' : '' %>">
<div class="halo halo-lime"></div>
<div class="halo halo-heat"></div>
<header class="barre barre-porte">
  <a class="logo" href="/"><svg class="sceau" viewBox="0 0 40 40" aria-hidden="true"><path d="M6 26c7-14 21-14 28 0" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/><circle cx="30" cy="11" r="3" fill="#ff5a36"/></svg>StageHub</a>
  <nav>
    <% if (typeof accueil !== 'undefined' && accueil) { %>
      <a href="/inscription">Créer un compte</a>
      <a class="btn btn-petit btn-bleu" href="#entrer">Entrer</a>
    <% } else { %>
      <a href="/">Connexion</a>
      <a class="btn btn-petit btn-bleu" href="/inscription">S'inscrire</a>
    <% } %>
  </nav>
</header>
<% if (typeof accueil !== 'undefined' && accueil) { %>
<section class="hero-copie">
  <p class="kicker">StageHub</p>
  <h1>Le bon stage.<span>Ton geste.</span></h1>
  <p class="lede">Tu filtres, tu swipes, tu gardes. La convention, le journal et la note suivent après — étudiants, entreprises, encadrants.</p>
  <div class="tuiles">
    <a class="tuile tuile-1" href="#entrer"><small>01</small><b>Filtrer</b><span>Ville, durée, mot-clé. Une seule recherche.</span></a>
    <a class="tuile tuile-2" href="#entrer"><small>02</small><b>Swiper</b><span>À gauche tu passes. À droite tu gardes la piste.</span></a>
    <a class="tuile tuile-3" href="#entrer"><small>03</small><b>Suivre</b><span>Dossier, journal de bord, encadrant, note de fin.</span></a>
  </div>
</section>
<div class="apercu" id="apercu">
  <div class="piste-mini" id="piste-mini">
    <article class="mini teinte-0" data-place="0">
      <p>TechNord</p>
      <h3>Développeur web</h3>
      <span>Tanger · 4 mois</span>
    </article>
    <article class="mini teinte-2" data-place="1">
      <p>DataMaroc</p>
      <h3>Analyse de données</h3>
      <span>Rabat · 6 mois</span>
    </article>
    <article class="mini teinte-3" data-place="2">
      <p>Atlas Conseil</p>
      <h3>Audit applicatif</h3>
      <span>Casablanca · 3 mois</span>
    </article>
  </div>
  <p class="chip chip-a">Ville, durée, mot-clé</p>
  <p class="chip chip-b">Un swipe, une candidature</p>
</div>
<% } %>
<main class="feuille" id="entrer">
<div class="auth-box<%= typeof large !== 'undefined' && large ? ' large' : '' %>">
<% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
<% if (typeof compteInactif !== 'undefined' && compteInactif) { %><div class="flash flash-ko" role="status">Ce compte est désactivé. Contacte l'administrateur.</div><% } %>
